# --- Local development (default path) -----------------------------------------
# `task dev` runs a local Convex dev deployment via the Convex CLI and loads
# this file. The CLI writes its own URLs to .env.local; this value must match
# the CONVEX_URL from there so the web app can reach the backend.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3212

# --- Vercel ---------------------------------------------------------------------
# Nothing to configure here: the Convex Marketplace integration provides
# CONVEX_DEPLOY_KEY on Vercel, and scripts/vercel-build.mjs handles the rest
# (including NEXT_PUBLIC_CONVEX_URL and the Convex Auth keys).

# --- Self-hosted stack (docker compose) ----------------------------------------
# Used when running the production-like stack with `task dev:containers`.
# Generate the admin key with `task convex:admin-key`.
CONVEX_SERVER_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-generated-admin-key-for-self-hosted-convex

# --- Reserved for future email delivery work (read by nothing yet) -------------
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=ShulStack <noreply@localhost>
