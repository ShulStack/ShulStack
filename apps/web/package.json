{
  "name": "@shulstack/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev --webpack",
    "generate": "pnpm payload:types && pnpm payload:importmap",
    "lint": "biome check .",
    "payload:importmap": "payload generate:importmap --config src/payload.config.ts",
    "payload:types": "payload generate:types --config src/payload.config.ts",
    "start": "next start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.80.0",
    "@payloadcms/next": "^3.80.0",
    "@payloadcms/richtext-lexical": "^3.80.0",
    "@shulstack/auth": "workspace:*",
    "@shulstack/cms": "workspace:*",
    "@shulstack/db": "workspace:*",
    "@shulstack/platform": "workspace:*",
    "@shulstack/ui": "workspace:*",
    "better-auth": "^1.5.6",
    "next": "^16.2.1",
    "payload": "^3.80.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sass": "^1.98.0"
  }
}
